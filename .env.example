# Molong .env
# LLM (OpenAI-compatible; NOT OpenAI/Anthropic for the "Beyond the Big Two" category)
LLM_API_KEY=your-j..._key
LLM_BASE_URL=https://je.jerouter.web.id/v1
LLM_MODEL=ling-3.0-flash-fin

# Walrus Memory relayer (mainnet public relayer is default)
# RELAYER_URL=https://relayer.memory.walrus.xyz

# Optional: explicit creds file
# CREDS_FILE=/abs/path/to/creds_mainnet.json

# Optional: in-memory mock (no chain) — for local dev/tests
# USE_MOCK=1

PORT=8090
